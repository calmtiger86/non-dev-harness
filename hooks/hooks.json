{
  "description": "non-dev-harness: 하네스 프로젝트에서 세션을 시작할 때 /ci, /co 안내",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
